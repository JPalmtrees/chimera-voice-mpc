+    def extra_link(self, target):
+        """Prebuilt libraries and linker flags for one target, from the project's optional link.json:
+        {"arm32": ["lib/arm32/libfoo.a", "-lpthread"], "arm64": [...], "native": [...], "desktop": [...]}.
+        Paths are relative to the project; entries starting with '-' are passed as they are."""
+        path = os.path.join(self.project, "link.json")
+        if not os.path.isfile(path):
+            return []
+        with open(path, encoding="utf-8") as fh:
+            spec = json.load(fh)
+        out = []
+        for e in spec.get(target, []):
+            if e.startswith("-"):
+                out.append(e)
+            else:
+                f = os.path.normpath(os.path.join(self.project, e))
+                if not os.path.isfile(f):
+                    raise BuildError("link.json (%s): %s not found. Build it first (see the project's README)." % (target, f))
+                out.append(f)
+        return out
+
